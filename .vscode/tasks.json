{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "transaction-cost-analysis-tool"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^ERROR.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*>\\s*vite\\s*$",
          "endsPattern": "ready in \\d+ ms"
        }
      }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "transaction-cost-analysis-tool"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "transaction-cost-analysis-tool"
      },
      "problemMatcher": []
    },
    {
      "label": "preview",
      "type": "npm",
      "script": "preview",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "transaction-cost-analysis-tool"
      },
      "problemMatcher": []
    }
  ]
}
