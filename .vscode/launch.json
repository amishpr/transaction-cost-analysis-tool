{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome against dev server",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5180",
      "webRoot": "${workspaceFolder}/src",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      },
      "preLaunchTask": "dev"
    },
    {
      "name": "Launch Edge against dev server",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5180",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "dev"
    },
    {
      "name": "Attach to running dev server (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5180",
      "webRoot": "${workspaceFolder}/src"
    }
  ]
}
